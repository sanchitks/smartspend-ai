# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local quick-start; PostgreSQL for hosted, e.g.
# DATABASE_URL=postgresql+psycopg://smartspend:smartspend@localhost:5432/smartspend
DATABASE_URL=sqlite:///./smartspend.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_MAX_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI_PROVIDER: auto (Claude when ANTHROPIC_API_KEY is set, otherwise the offline demo provider),
# anthropic, or mock.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=20
